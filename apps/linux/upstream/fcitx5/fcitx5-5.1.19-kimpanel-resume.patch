+void Kimpanel::updateCursor(InputContext *inputContext) {
+    if (!proxy_ || !inputContext || !inputContext->hasFocus()) {
+        return;
+    }
+    CursorRectMethod method = CursorRectMethod::SetSpotRect;
+    if (inputContext->capabilityFlags().test(CapabilityFlag::RelativeRect)) {
+        // 不能在异步协商尚未结束时将相对坐标作为屏幕绝对坐标发送。
+        if (relativeQuery_) {
+            return;
+        }
+        if (hasRelativeV2_) {
+            method = CursorRectMethod::SetRelativeSpotRectV2;
+        } else if (hasRelative_) {
+            method = CursorRectMethod::SetRelativeSpotRect;
+        }
+    }
+    proxy_->updateCursor(inputContext, method);
