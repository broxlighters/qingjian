new file mode 100644
--- /dev/null
+++ b/src/frontend/waylandim/waylandim_popup_public.h
@@ -0,0 +1,81 @@
+//! waylandim 的最小 v2 popup 公共接口；不暴露内部 Wayland wrapper。
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef FCITX_WAYLANDIM_POPUP_PUBLIC_H
+#define FCITX_WAYLANDIM_POPUP_PUBLIC_H
+
+#include <functional>
+#include <memory>
+#include <fcitx/addoninstance.h>
+
+struct wl_display;
+struct wl_surface;
+
+namespace fcitx {
+class InputContext;
+
+enum class WaylandPopupAvailability {
+    Available,
+    InvalidContext,
+    UnsupportedFrontend, // v1、IBus/GNOME Shell 均不支持。
+    DisplayMismatch,
+    Inactive,
+    Restricted, // Password、Sensitive、Disable 或客户端自绘面板。
+    MissingCompositor,
+    Unavailable, // 连接关闭、input-method unavailable 或正在撤窗。
+};
+
+enum class WaylandPopupCloseReason {
+    Closed,
+    ContextChanged, // 失焦、销毁、reset、能力变化或输入法切换。
+    Deactivated,
+    Unavailable,
+    ConnectionClosed,
+    ModuleUnloaded,
+};
+
+using WaylandPopupClosed = std::function<void(WaylandPopupCloseReason)>;
+
+/**
+ * Fcitx 主线程专用。调用者拥有句柄，Fcitx 拥有 surface 和 v2 role。
+ * 只支持激活且匹配的 wayland_v2 上下文（包括它当前委托的虚拟上下文）。
+ * 不负责默认面板互斥；调用者仍须管理 custom InputPanel callback。
+ *
+ * surface 与 display 保证同连接；借用仅到 close/失效为止。禁止销毁它们、
+ * 设置它们的 listener/user_data/event queue 或给 surface 分配其它 role。
+ * surface listener/user_data 已由 Fcitx 占用。可使用原始 C surface 请求，
+ * 自建 wl_callback、wl_buffer 等对象可拥有各自的 listener/user_data。
+ * 所有附加对象（buffer、region 等）必须来自此 display，调用者负责保证。
+ * Fcitx 是唯一连接 reader：禁止 dispatch、read、prepare_read、roundtrip、
+ * disconnect 和第二个 fd reader；Fcitx 负责异步 dispatch/flush。
+ *
+ * 首版固定逻辑像素、buffer scale=1；不提供输出/缩放通知或鼠标交互保证。
+ * 默认空连接名 wayland: 合法。v2 popup protocol version 为 1。
+ *
+ * 失效先撤下并销毁 role/surface、使两个 getter 返回 nullptr，再同步调用
+ * closed 一次；此时连接尚未 disconnect。closed 必须销毁该 popup 所有
+ * 自建 Wayland proxy（尤其 frame callback/buffer/registry），不可等待
+ * release，并清除缓存指针。已提交 buffer 的存储不可覆写至 release；
+ * 销毁 proxy 后可释放自己的映射/FD，compositor 仍持有其映射。
+ * closed 可同步释放句柄/关闭其它句柄；不得抛异常、卸载 addon、销毁
+ * Instance/InputContext 或递归运行事件循环。自动失效回调期间不能创建 popup。
+ *
+ * close() 幂等且同步触发 closed；仅析构句柄则撤窗但不调用 closed，
+ * 因此消费者析构时须自行先销毁自建对象，或在成员析构前显式 close()。
+ * 已失效句柄可保留至 waylandim 卸载前；所有句柄必须在 addon 卸载前释放。
+ */
+class WaylandPopup {
+public:
+    virtual ~WaylandPopup() = default;
+    virtual wl_display *display() const = 0;
+    virtual wl_surface *surface() const = 0;
+    virtual void close() = 0;
+};
+} // namespace fcitx
+
+FCITX_ADDON_DECLARE_FUNCTION(WaylandIMModule, queryPopup,
+    fcitx::WaylandPopupAvailability(fcitx::InputContext *));
+// 空 closed 或重新检查失败时返回 nullptr；失败不会调用 closed。
+FCITX_ADDON_DECLARE_FUNCTION(WaylandIMModule, createPopup,
+    std::unique_ptr<fcitx::WaylandPopup>(fcitx::InputContext *, fcitx::WaylandPopupClosed));
+
+#endif
