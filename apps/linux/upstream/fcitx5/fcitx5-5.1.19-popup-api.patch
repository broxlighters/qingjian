--- /dev/null
+++ b/src/frontend/waylandim/popup.cpp
@@ -0,0 +1,190 @@
+//! popup 创建、上下文校验与同步失效；连接读写仍由 wayland 模块调度。
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "popup.h"
+#include <algorithm>
+#include <utility>
+#include "fcitx-utils/capabilityflags.h"
+#include "fcitx/event.h"
+#include "waylandim.h"
+#include "waylandimserverv2.h"
+#include "wl_compositor.h"
+
+namespace fcitx {
+namespace {
+class PopupHandle final : public WaylandPopup {
+public:
+    explicit PopupHandle(std::shared_ptr<WaylandPopupState> state)
+        : state_(std::move(state)) {}
+    ~PopupHandle() override {
+        state_->finish(WaylandPopupCloseReason::Closed, false);
+    }
+    wl_display *display() const override { return state_->display; }
+    wl_surface *surface() const override {
+        return wayland::rawPointer(state_->surface.get());
+    }
+    void close() override {
+        // 回调可能析构 this；栈上保持状态存活，回调后不再访问句柄。
+        auto state = state_;
+        state->finish(WaylandPopupCloseReason::Closed);
+    }
+private:
+    std::shared_ptr<WaylandPopupState> state_;
+};
+
+WaylandIMInputContextV2 *popupParent(InputContext *ic) {
+    if (auto *parent = dynamic_cast<WaylandIMInputContextV2 *>(ic)) {
+        return parent;
+    }
+    if (auto *virtualIC = dynamic_cast<VirtualInputContext *>(ic)) {
+        return dynamic_cast<WaylandIMInputContextV2 *>(virtualIC->parent());
+    }
+    return nullptr;
+}
+
+bool restricted(InputContext *ic) {
+    return ic->capabilityFlags().testAny(CapabilityFlags{
+        CapabilityFlag::Password, CapabilityFlag::Sensitive,
+        CapabilityFlag::Disable, CapabilityFlag::ClientSideInputPanel});
+}
+} // namespace
+
+WaylandPopupState::~WaylandPopupState() {
+    finish(WaylandPopupCloseReason::Closed, false);
+}
+
+void WaylandPopupState::finish(WaylandPopupCloseReason reason, bool notify) {
+    if (!display) {
+        return;
+    }
+    // 必须先使查询不可用，再通知消费者；重入 close() 不会重复通知。
+    auto callback = std::move(closed);
+    display = nullptr;
+    context = nullptr;
+    parent = nullptr;
+    surface->attach(nullptr, 0, 0);
+    surface->commit();
+    role.reset();
+    surface.reset();
+    if (notify && callback) {
+        callback(reason);
+    }
+}
+
+WaylandPopupAvailability WaylandIMModule::queryPopup(InputContext *ic) {
+    using A = WaylandPopupAvailability;
+    if (!ic) {
+        return A::InvalidContext;
+    }
+    if (stoppingPopups_ || invalidatingPopups_) {
+        return A::Unavailable;
+    }
+    if (ic->frontendName() != "wayland_v2") {
+        return A::UnsupportedFrontend;
+    }
+    auto *parent = popupParent(ic);
+    if (!parent) {
+        return A::InvalidContext;
+    }
+    auto *server = parent->server();
+    const auto displayName = ic->display();
+    if (displayName.compare(0, 8, "wayland:") != 0) {
+        return A::DisplayMismatch;
+    }
+    const auto name = displayName.substr(8); // 空默认连接名合法。
+    auto iter = serversV2_.find(name);
+    if (iter == serversV2_.end() || iter->second.get() != server ||
+        ic->focusGroup() != server->group()) {
+        return A::DisplayMismatch;
+    }
+    if (parent->popupUnavailable()) {
+        return A::Unavailable;
+    }
+    if (!parent->popupActive() || !parent->realFocus() || !ic->hasFocus() ||
+        parent->delegatedInputContext() != ic) {
+        return A::Inactive;
+    }
+    if (restricted(ic) || restricted(parent)) {
+        return A::Restricted;
+    }
+    auto *display = server->display();
+    const auto seats = display->getGlobals<wayland::WlSeat>();
+    if (!display->getGlobal<wayland::ZwpInputMethodManagerV2>() ||
+        std::none_of(seats.begin(), seats.end(), [parent](const auto &seat) {
+            return seat.get() == parent->popupSeat();
+        }) ||
+        wl_display_get_error(*display)) {
+        return A::Unavailable;
+    }
+    if (!display->getGlobal<wayland::WlCompositor>()) {
+        return A::MissingCompositor;
+    }
+    return A::Available;
+}
+
+std::unique_ptr<WaylandPopup>
+WaylandIMModule::createPopup(InputContext *ic, WaylandPopupClosed closed) {
+    if (!closed || queryPopup(ic) != WaylandPopupAvailability::Available) {
+        return nullptr;
+    }
+    auto *parent = popupParent(ic);
+    auto *display = parent->server()->display();
+    auto compositor = display->getGlobal<wayland::WlCompositor>();
+    // 使用原始请求先检查分配失败，再交给内部 wrapper 安装 listener。
+    auto *surface = wl_compositor_create_surface(
+        wayland::rawPointer(compositor.get()));
+    if (!surface) {
+        return nullptr;
+    }
+    auto state = std::make_shared<WaylandPopupState>();
+    state->surface = std::make_unique<wayland::WlSurface>(surface);
+    auto *role = zwp_input_method_v2_get_input_popup_surface(
+        wayland::rawPointer(parent->inputMethodV2()), surface);
+    if (!role) {
+        return nullptr;
+    }
+    state->role = std::make_unique<wayland::ZwpInputPopupSurfaceV2>(role);
+    state->context = ic;
+    state->parent = parent;
+    state->display = *display;
+    state->closed = std::move(closed);
+    std::erase_if(popups_, [](const auto &popup) { return popup.expired(); });
+    popups_.push_back(state);
+    return std::make_unique<PopupHandle>(std::move(state));
+}
+
+void WaylandIMModule::invalidatePopups(WaylandPopupCloseReason reason,
+                                      InputContext *ic, wl_display *display) {
+    const bool oldInvalidating = invalidatingPopups_;
+    invalidatingPopups_ = true;
+    // 固定快照：回调可释放其它句柄或重入失效，不使迭代器失效。
+    std::vector<std::shared_ptr<WaylandPopupState>> states;
+    for (const auto &weak : popups_) {
+        if (auto state = weak.lock(); state && state->display &&
+            (!ic || state->context == ic || state->parent == ic) &&
+            (!display || state->display == display)) {
+            states.push_back(std::move(state));
+        }
+    }
+    for (auto &state : states) {
+        state->finish(reason);
+    }
+    invalidatingPopups_ = oldInvalidating;
+}
+
+void WaylandIMModule::watchPopupContexts() {
+    for (auto type : {EventType::InputContextDestroyed,
+                      EventType::InputContextFocusOut,
+                      EventType::InputContextCapabilityAboutToChange,
+                      EventType::InputContextCapabilityChanged,
+                      EventType::InputContextReset,
+                      EventType::InputContextSwitchInputMethod,
+                      EventType::InputContextInputMethodDeactivated}) {
+        popupEvents_.push_back(instance_->watchEvent(
+            type, EventWatcherPhase::PreInputMethod, [this](Event &event) {
+                invalidatePopups(WaylandPopupCloseReason::ContextChanged,
+                                 static_cast<InputContextEvent &>(event)
+                                     .inputContext());
+            }));
+    }
+}
+} // namespace fcitx
