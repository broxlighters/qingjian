+//! 内部 popup 状态；独立于消费者句柄，允许失效回调同步释放句柄。
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#ifndef FCITX_WAYLANDIM_POPUP_H
+#define FCITX_WAYLANDIM_POPUP_H
+
+#include <memory>
+#include "waylandim_popup_public.h"
+#include "wl_surface.h"
+#include "zwp_input_popup_surface_v2.h"
+
+namespace fcitx {
+class WaylandIMInputContextV2;
+
+class WaylandPopupState {
+public:
+    ~WaylandPopupState();
+    void finish(WaylandPopupCloseReason reason, bool notify = true);
+
+    InputContext *context = nullptr;
+
+    WaylandIMInputContextV2 *parent = nullptr;
+
+    wl_display *display = nullptr;
+
+    std::unique_ptr<wayland::WlSurface> surface;
+
+    std::unique_ptr<wayland::ZwpInputPopupSurfaceV2> role;
+
+    WaylandPopupClosed closed;
+};
+} // namespace fcitx
+#endif
